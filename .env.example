# KhetSetu Environment Configuration

# Application
PROJECT_NAME="KhetSetu API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database (PostgreSQL 16 with JSONB)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=khetsetu
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/khetsetu

# Security
SECRET_KEY="temporary-dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hosted Routing (OpenRouteService or public OSRM for prototype)
ROUTING_API_BASE_URL="https://router.project-osrm.org"
