# KhetSetu Backend Environment Configuration

# Database Configuration
# Option A: Local PostgreSQL (Standard)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/khetsetu

# Option B: Local SQLite (Quick offline development without PostgreSQL)
# DATABASE_URL=sqlite+aiosqlite:///./khetsetu.db

# Application Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-change-in-production
